PORT=3001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=PPE

# KAN-12 : secret qui signe les tokens de connexion (32 caracteres minimum).
# Chaque personne met SA propre valeur, jamais commitee. Pour en generer une :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Laisse vide en dev : un secret temporaire est genere au demarrage (il faut
# alors se reconnecter apres chaque redemarrage du backend).
AUTH_SECRET=
